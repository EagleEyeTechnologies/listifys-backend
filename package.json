{
  "name": "listifys-api",
  "version": "0.1.0",
  "private": true,
  "description": "Listifys Express + TypeScript API (v2)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "dev:worker": "npx tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "seed": "npx tsx src/scripts/seed.ts",
    "migrate:stub": "npx tsx src/scripts/migrate-listings.stub.ts",
    "migrate:prod": "tsx src/scripts/migrate-production-to-newlistifysdb.ts",
    "migrate:prod:write": "tsx src/scripts/migrate-production-to-newlistifysdb.ts --write",
    "migrate:prod:addresses": "tsx src/scripts/migrate-production-to-newlistifysdb.ts --write --collections=addresses",
    "migrate:verify": "tsx src/scripts/verify-newlistifysdb.ts",
    "chat:decrypt": "npx tsx src/scripts/backfill-chat-decrypt.ts",
    "chat:decrypt:write": "npx tsx src/scripts/backfill-chat-decrypt.ts --write",
    "chat:merge": "npx tsx src/scripts/merge-chat-conversations.ts",
    "chat:merge:write": "npx tsx src/scripts/merge-chat-conversations.ts --write",
    "slugs:backfill": "npx tsx src/scripts/backfill-slugs.ts",
    "slugs:backfill:write": "npx tsx src/scripts/backfill-slugs.ts --write"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.993.0",
    "@aws-sdk/s3-request-presigner": "^3.993.0",
    "@elastic/elasticsearch": "^9.3.4",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@upstash/redis": "^1.38.4",
    "argon2": "^0.44.0",
    "bullmq": "^5.34.5",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.2.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^3.24.1"
  }
}
