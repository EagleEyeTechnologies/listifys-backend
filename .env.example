NODE_ENV=development
PORT=5001

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/newlistifysdb
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# Migration: production → newlistifysdb (npm run migrate:prod -- --write)
# Uses MONGODB_URI cluster host; forces SOURCE_DB_NAME=production and
# TARGET_DB_NAME=newlistifysdb even if MONGODB_URI path is newlistifysdb.
# Or set explicit URIs:
# SOURCE_MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/production?retryWrites=true&w=majority
# TARGET_MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/newlistifysdb?retryWrites=true&w=majority
# SOURCE_DB_NAME=production
# TARGET_DB_NAME=newlistifysdb
# MIGRATE_BATCH_SIZE=200

# CORS / market
CLIENT_URL=http://localhost:3000
# Local admin (next dev -p 3001) + optional extras
# CORS_ORIGINS=http://localhost:3001
DEFAULT_COUNTRY_CODE=IN

# Comma-separated marketplace emails allowed into /api/admin/*
# ADMIN_EMAILS=you@example.com,ops@example.com

# Optional — falls back to in-memory OTP/token store if unset
REDIS_URL=redis://127.0.0.1:6379

# Optional — Elasticsearch indexing becomes a no-op if unset
# ELASTICSEARCH_URL=http://127.0.0.1:9200
# ELASTIC_USERNAME=
# ELASTIC_PASSWORD=

# Optional — media presign returns mock URLs if unset
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=
# AWS_S3_BUCKET_URL=

OTP_TTL_SECONDS=300

# Optional — Places autocomplete/details/reverse return 503 MAPS_NOT_CONFIGURED if unset
# GOOGLE_MAPS_SERVER_KEY=

# Social auth (same keys as version-1/server — copy from server/.env)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# GOOGLE_MOBILE_WEB_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_CLIENT_IDS=
# APPLE_BUNDLE_ID=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_IDS=

# Legacy chat message decryption (AES-256-GCM) — copy from version-1/server
# CHAT_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# OTP delivery (optional)
# Codes are always generated + stored in Redis/memory; verify still checks that store.
# Without a provider: non-prod logs the code (delivery: "logged");
# production throws 503 OTP_DELIVERY_UNAVAILABLE.
# ---------------------------------------------------------------------------

# Twilio SMS via Messages API (not Verify). Requires all three:
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567
# Optional — reserved if you switch to Twilio Verify later (verify flow would change):
# TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# Email via Resend (fetch-based; preferred when set):
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Listifys <noreply@yourdomain.com>
# Payments (boost / premium)
# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
